{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/clean-build.mjs && tsgo -p tsconfig.json && tsc-alias -p tsconfig.alias.json && node scripts/check-dist-imports.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e:api": "tsx e2e-api/src/run.ts",
    "e2e:matrix": "tsx e2e-api/src/matrix/run.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "db:generate": "node --import tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --import tsx src/db/migrate.ts",
    "db:migrate:drizzle": "node --import tsx node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node --import tsx node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --import tsx node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@clickhouse/client": "^1.13.0",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@hono/node-server": "^1.19.15",
    "@hono/node-ws": "^1.3.0",
    "@hono/zod-openapi": "^0.18.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@peculiar/asn1-ocsp": "^2.3.13",
    "@peculiar/asn1-schema": "^2.3.13",
    "@peculiar/asn1-x509": "^2.3.13",
    "@peculiar/x509": "^1.12.3",
    "@scalar/hono-api-reference": "^0.5.169",
    "@simplewebauthn/server": "^13.3.2",
    "acme-client": "^5.4.0",
    "ajv": "^8.18.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.78.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "handlebars": "^4.7.9",
    "hono": "^4.12.34",
    "ioredis": "^5.4.2",
    "libsodium-wrappers": "0.7.15",
    "nanoid": "^5.1.16",
    "node-cron": "^4.2.1",
    "node-forge": "^1.3.1",
    "nodemailer": "^9.0.3",
    "openai": "^6.33.0",
    "openid-client": "^6.3.1",
    "otpauth": "^9.5.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "ssh2": "^1.17.0",
    "tldts": "^7.4.10",
    "tsyringe": "^4.8.0",
    "winston": "^3.17.0",
    "ws": "8.21.0",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@biomejs/biome": "^2.4.9",
    "@types/libsodium-wrappers": "0.7.13",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/node-forge": "^1.3.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-kit": "^0.31.9",
    "openai7": "npm:openai@7.0.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "7.3.5",
    "vitest": "^4.1.5"
  }
}
