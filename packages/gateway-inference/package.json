{
  "name": "@sqgateway/inference",
  "version": "0.3.13",
  "description": "Interactive inference companion for Opfield",
  "type": "module",
  "bin": {
    "gateway-inference": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/the-square-labs/gateway.git",
    "directory": "packages/gateway-inference"
  },
  "bugs": {
    "url": "https://github.com/the-square-labs/gateway/issues"
  },
  "homepage": "https://github.com/the-square-labs/gateway/tree/main/packages/gateway-inference#readme",
  "license": "PolyForm-Perimeter-1.0.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE.md",
    "CONTINUITY-GRANT.md",
    "COMMERCIAL-LICENSE.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "rm -rf dist && esbuild src/cli.ts --bundle --platform=node --target=node22 --format=esm --external:@napi-rs/keyring --external:@napi-rs/keyring-* --outfile=dist/cli.js --banner:js='#!/usr/bin/env node\nimport { createRequire as __createRequire } from \"node:module\"; const require = __createRequire(import.meta.url);' && chmod 755 dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "1.3.0",
    "ws": "8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "esbuild": "0.25.12",
    "typescript": "^5.7.2",
    "vite": "7.3.5",
    "vitest": "^4.1.5"
  }
}
