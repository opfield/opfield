{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "opfield-updates",
	"main": "src/index.ts",
	"account_id": "4bea894ec0ae206680978dfaae0cfa00",
	"compatibility_date": "2026-08-27",
	"workers_dev": false,
	"routes": [
		{ "pattern": "get.opfield.dev/opfield/*", "zone_name": "opfield.dev" },
		{ "pattern": "get.opfield.dev/gateway/*", "zone_name": "opfield.dev" }
	],
	"vars": {
		"GITHUB_OWNER": "opfield",
		"GITHUB_OPFIELD_REPO": "opfield",
		"GITHUB_INFERENCE_CORE_REPO": "opfield-inference"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"cache": {
		"enabled": true,
		"cross_version_cache": true
	}
}
