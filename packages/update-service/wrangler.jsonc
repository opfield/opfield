{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "gateway-updates",
	"main": "src/index.ts",
	"account_id": "22dece7280b0afbe29b9ce6c79161b85",
	"compatibility_date": "2026-08-27",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "updates.thesqlabs.com",
			"custom_domain": true
		},
		// Same Worker on the Opfield host: the feed and artifacts under /gateway/*, the server installer at the root.
		{ "pattern": "get.opfield.dev/gateway/*", "zone_name": "opfield.dev" },
		{ "pattern": "get.opfield.dev/", "zone_name": "opfield.dev" },
		{ "pattern": "get.opfield.dev/install.sh", "zone_name": "opfield.dev" }
	],
	"vars": {
		"GITHUB_OWNER": "the-square-labs",
		"GITHUB_GATEWAY_REPO": "gateway",
		"GITHUB_INFERENCE_CORE_REPO": "inference-core"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"cache": {
		"enabled": true,
		"cross_version_cache": true
	}
}
