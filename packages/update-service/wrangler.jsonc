{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "opfield-updates",
	"main": "src/index.ts",
	"account_id": "22dece7280b0afbe29b9ce6c79161b85",
	"compatibility_date": "2026-08-27",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "updates.thesqlabs.com",
			"custom_domain": true
		}
		// get.opfield.dev lives in another Cloudflare account, so a route there can't target this Worker; a small proxy
		// Worker in that account forwards get.opfield.dev to this host with the same paths.
	],
	"vars": {
		"GITHUB_OWNER": "opfield",
		"GITHUB_OPFIELD_REPO": "opfield",
		"GITHUB_INFERENCE_CORE_REPO": "opfield-inference"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"cache": {
		"enabled": true,
		"cross_version_cache": true
	}
}
