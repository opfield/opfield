# Server
PORT=3000
NODE_ENV=development
# Fresh installer bootstrap only. Canonical public URL is configured in Opfield.
SETUP_BOOTSTRAP=false
WEB_TLS_BOOTSTRAP_MODE=http
WEB_TLS_AUTO_DIR=/var/lib/gateway/tls
# Comma-separated private/link-local addresses assigned to the Docker host.
# The installer detects these so direct local access remains available after setup.
OPFIELD_LOCAL_HOSTS=

# Database
DATABASE_URL=postgres://dev:dev@localhost:55432/opfield

# Redis
REDIS_URL=redis://localhost:6379

# Node-level Docker Route transport. Production releases set a digest-pinned ref.
SECURE_LINK_CONNECTOR_IMAGE=

# Request limits, logging ingest guardrails, sessions, rate limiting, and PKI
# defaults are configured in Settings > Environment and are not env variables.
# ACME uses the signed-in user's email and the provider selected in the UI.

# PKI Master Key (32 bytes as 64-char hex string)
# Used for envelope encryption of all CA and certificate private keys
# Generate with: openssl rand -hex 32
PKI_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# gRPC (daemon communication)
GRPC_PORT=9443
# Opfield gRPC is always TLS. Omit custom cert/key to auto-issue an internal PKI server cert here.
GRPC_TLS_AUTO_DIR=/var/lib/gateway/tls
# Extra comma-separated DNS names or IP addresses for the auto-issued gRPC server certificate.
# GRPC_TLS_EXTRA_SANS=opfield.example.com,203.0.113.10
# GRPC_TLS_CERT=/path/to/cert.pem
# GRPC_TLS_KEY=/path/to/key.pem

# Background Jobs
HEALTH_CHECK_INTERVAL_SECONDS=30
ACME_RENEWAL_CRON=0 3 * * *
EXPIRY_CHECK_CRON=0 6 * * *

# Optional native backup runner override (repository@sha256:...). Empty uses the runner bundled with the Opfield release.
BACKUP_RUNNER_IMAGE=
